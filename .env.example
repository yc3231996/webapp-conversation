# APP ID
NEXT_PUBLIC_APP_ID=
# APP API key
NEXT_PUBLIC_APP_KEY=
# API url prefix
NEXT_PUBLIC_API_URL=


# JWT Secret - 请在生产环境中使用强随机密钥
JWT_SECRET=your-very-long-and-secure-random-secret-key-here

# 用户配置 - 格式: username:password,username:password
# 密码将自动进行哈希处理
DEFAULT_USERS=admin:admin123,user:user123
